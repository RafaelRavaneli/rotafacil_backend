# Chave secreta usada para assinar os tokens JWT.
# Gere uma string aleatória forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
KEY=sua_chave_secreta_aqui

# Credenciais da API do ImgBB (https://api.imgbb.com/), usada para upload de imagens
IMGBB_API_KEY=sua_chave_do_imgbb_aqui
URL_IMGBB=https://api.imgbb.com/1/upload
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app

# Arquivo privado de credenciais do Firebase.
# No Render, use /etc/secrets/firebase-key.json.
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# Servico de rotas ate o inicio da trilha.
ORS_API_KEY=sua_chave_openrouteservice

# E-mail de recuperacao de senha via Gmail SMTP.
EMAIL_REMETENTE=seu_email@gmail.com
EMAIL_SENHA_APP=sua_senha_de_aplicativo

# Origens autorizadas, separadas por virgula e sem barra final.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Agendador embutido apenas para execucao local com python app.py.
# Em producao, mantenha false e execute python enviar_lembretes.py por cron.
ENABLE_SCHEDULER=false
FLASK_DEBUG=false

# Vercel: cadastre o JSON completo da conta de serviço como variável sensível.
# Quando preenchida, esta variável tem precedência sobre FIREBASE_CREDENTIALS_PATH.
FIREBASE_CREDENTIALS_JSON=
